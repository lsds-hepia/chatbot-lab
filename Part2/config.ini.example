# Copy this file to config.ini and fill in your values.
# No AWS keys here: the instance gets its credentials from its IAM role.

[aws]
region = us-east-1

[opensearch]
endpoint = YOUR_OPENSEARCH_ENDPOINT
index_name = YOUR_INDEX_NAME

[bedrock]
# Check these exist in your region with: aws bedrock list-foundation-models
embed_model_id = amazon.titan-embed-text-v2:0
chat_model_id = us.anthropic.claude-haiku-4-5-20251001-v1:0
